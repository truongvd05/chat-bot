model Message {
    id              BigInt       @id @default(autoincrement())
    conversationId  BigInt       @map("conversation_id")
    parentMessageId BigInt?      @map("parent_message_id")
    userId          BigInt?      @map("user_id")
    role            MessageRole? // dùng với chat bot 
    content         String       @db.LongText
    isEdited        Boolean      @default(false) @map("is_edited")
    deletedAt       DateTime?    @map("deleted_at")
    createdAt       DateTime     @default(now()) @map("created_at")
    updatedAt       DateTime     @updatedAt @map("updated_at")

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

    parentMessage Message?            @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
    replies       Message[]           @relation("MessageReplies")
    attachments   MessageAttachment[]
    lastMessageOf Conversation[]      @relation("LastMessage")
    notifications Notification[]

    @@index([deletedAt])
    @@index([conversationId, createdAt])
    @@index([userId])
    @@index([parentMessageId])
    @@map("message")
}

enum MessageRole {
    user
    bot
}

model MessageAttachment {
    id        BigInt   @id @default(autoincrement())
    messageId BigInt   @map("message_id")
    fileName  String   @map("file_name")
    fileUrl   String   @map("file_url")
    fileType  String   @map("file_type")
    fileSize  Int      @map("file_size")
    createdAt DateTime @default(now()) @map("created_at")
    message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

    @@index([messageId])
    @@map("message_attachments")
}
