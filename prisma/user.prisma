model User {
  id              BigInt     @id @default(autoincrement())
  email           String     @unique
  name            String
  phonenumber     String?    @unique @map("phone_number")
  gender          String?
  bio             String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  birthday        String?    @map("birthday")
  avatarUrl       String?    @map("avatar_url")
  backgroundUrl   String?    @map("background_url")
  password        String // @note: Hashed password using bcrypt
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  refreshTokens            RefreshToken[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  passwordResetTokens      PasswordResetToken[]
  blockedUsers             UserBlock[]               @relation("Blocker")
  blockedBy                UserBlock[]               @relation("Blocked")
  ownedConversations       Conversation[]            @relation("ConversationOwner")
  sentFriendRequests       Friend[]                  @relation("FriendRequester")
  receivedFriendRequests   Friend[]                  @relation("FriendAddressee")
  receivedNotifications    Notification[]            @relation("UserNotifications")
  sentNotifications        Notification[]            @relation("SenderNotifications")
  posts                    Post[]
  postLikes                PostLike[]
  postSaves                PostSave[]
  postComments             PostComment[]
  reports                  Report[]
  conversationLabels       ConversationLabel[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BAN
}

model UserBlock {
  id        BigInt @id @default(autoincrement())
  blockerId BigInt @map("blocker_id")
  blockedId BigInt @map("blocked_id")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}
